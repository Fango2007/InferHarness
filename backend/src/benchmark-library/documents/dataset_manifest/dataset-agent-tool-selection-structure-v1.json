    {
      "id": "copilot-workspace-search",
      "system_prompt": "You are an agent runtime. Select exactly one tool when the user request requires an action. Do not answer in prose when a tool call is needed.",
      "prompt": "Find every workspace reference to validateApiToken under backend/src. Do not read a specific file and do not modify anything.",
      "interaction_mode": "tool_calling",
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "search_workspace",
            "description": "Search files in the workspace for a literal or regex query.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "description": "Search query."
                },
                "path": {
                  "type": "string",
                  "description": "Directory or file scope."
                },
                "regex": {
                  "type": "boolean",
                  "description": "Whether query is a regex."
                }
              },
              "required": [
                "query",
                "path",
                "regex"
              ]
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "read_file",
            "description": "Read a known file from the workspace.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ]
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "apply_patch",
            "description": "Apply a patch to workspace files.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "patch": {
                  "type": "string"
                }
              },
              "required": [
                "patch"
              ]
            }
          }
        }
      ],
      "tool_choice": "auto",
      "expected_tool_calls": [
        {
          "function": {
            "name": "search_workspace",
            "arguments": {
              "query": "validateApiToken",
              "path": "backend/src",
              "regex": false
            }
          }
        }
      ],
      "tags": [
        "agent",
        "copilot",
        "tool-selection",
        "workspace"
      ],
      "metadata": {
        "agent_profile": "copilot"
      }
    },
    {
      "id": "codex-apply-targeted-patch",
      "system_prompt": "You are an agent runtime. Select exactly one tool when the user request requires an action. Do not answer in prose when a tool call is needed.",
      "prompt": "Update backend/src/api/auth.ts by replacing timeout_ms: 1000 with timeout_ms: 1500. Do not run tests yet.",
      "interaction_mode": "tool_calling",
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "search_workspace",
            "description": "Search files in the workspace for a literal or regex query.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "regex": {
                  "type": "boolean"
                }
              },
              "required": [
                "query",
                "path",
                "regex"
              ]
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "apply_patch",
            "description": "Apply a simple exact replacement to one workspace file.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file_path": {
                  "type": "string"
                },
                "find": {
                  "type": "string"
                },
                "replace": {
                  "type": "string"
                }
              },
              "required": [
                "file_path",
                "find",
                "replace"
              ]
            }
          }
        },
        {
          "type": "function",
          "function": {
            "name": "run_tests",
            "description": "Run a test command.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "command": {
                  "type": "string"
                }
              },
              "required": [
                "command"
              ]
            }
          }
        }
      ],
      "tool_choice": "auto",
      "expected_tool_calls": [
        {
          "function": {
            "name": "apply_patch",
            "arguments": {
              "file_path": "backend/src/api/auth.ts",
              "find": "timeout_ms: 1000",
              "replace": "timeout_ms: 1500"
            }
          }
        }
      ],
      "tags": [
        "agent",
        "codex",
        "tool-selection",
        "patch"
      ],
      "metadata": {
        "agent_profile": "codex"
