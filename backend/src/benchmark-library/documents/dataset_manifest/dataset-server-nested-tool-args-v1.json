    {
      "id": "nested-filter-query",
      "system_prompt": "Use the query tool with exactly the requested filter object.",
      "prompt": "Search active enterprise accounts in EMEA tagged renewal and expansion, limit 25.",
      "interaction_mode": "tool_calling",
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "query_accounts",
            "description": "Query accounts.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "filter": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "Status."
                    },
                    "segment": {
                      "type": "string",
                      "description": "Segment."
                    },
                    "region": {
                      "type": "string",
                      "description": "Region."
                    },
                    "tags": {
                      "type": "array",
                      "description": "Tags.",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "status",
                    "segment",
                    "region",
                    "tags"
                  ]
                },
                "limit": {
                  "type": "integer",
                  "description": "Maximum results."
                }
              },
              "required": [
                "filter",
                "limit"
              ]
            }
          }
        }
      ],
      "tool_choice": {
        "type": "function",
        "function": {
          "name": "query_accounts"
        }
      },
      "expected_tool_calls": [
        {
          "function": {
            "name": "query_accounts",
            "arguments": {
              "filter": {
                "status": "active",
                "segment": "enterprise",
                "region": "EMEA",
                "tags": [
                  "renewal",
                  "expansion"
                ]
              },
              "limit": 25
            }
          }
        }
      ],
      "tags": [
        "server",
        "nested-arguments"
      ]
    },
    {
      "id": "nested-code-review",
      "system_prompt": "Use the review tool with exactly the requested nested payload.",
      "prompt": "Request a blocking review for src/auth.ts on security and tests with severity high.",
      "interaction_mode": "tool_calling",
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "request_review",
            "description": "Request code review.",
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string",
                  "description": "File path."
                },
                "checks": {
                  "type": "array",
                  "description": "Review check names.",
                  "items": {
                    "type": "string"
                  }
                },
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "blocking": {
                      "type": "boolean",
                      "description": "Whether review is blocking."
                    },
                    "severity": {
                      "type": "string",
                      "description": "Severity.",
                      "enum": [
                        "low",
                        "medium",
                        "high"
                      ]
                    }
                  },
                  "required": [
                    "blocking",
                    "severity"
                  ]
                }
              },
              "required": [
                "file",
                "checks",
                "policy"
              ]
            }
          }
        }
      ],
      "tool_choice": {
        "type": "function",
        "function": {
          "name": "request_review"
        }
      },
      "expected_tool_calls": [
        {
          "function": {
            "name": "request_review",
            "arguments": {
              "file": "src/auth.ts",
              "checks": [
                "security",
                "tests"
              ],
              "policy": {
                "blocking": true,
                "severity": "high"
              }
            }
          }
        }
      ],
