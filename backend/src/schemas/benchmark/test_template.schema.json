{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inferharness.local/schemas/benchmark/test_template.schema.json",
  "title": "Benchmark TestTemplate",
  "description": "Reusable declarative benchmark definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "template_id", "template_version", "operation", "stages", "metrics", "aggregations"],
  "properties": {
    "kind": { "type": "string", "const": "test_template" },
    "schema_version": { "type": "string", "const": "benchmark_test_template_v1" },
    "template_id": { "type": "string", "minLength": 1 },
    "template_version": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "operation": { "type": "string", "enum": ["chat_completion", "completion", "embedding", "list_models", "healthcheck"] },
    "required_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat_completion": { "type": "boolean" },
        "completion": { "type": "boolean" },
        "embedding": { "type": "boolean" },
        "list_models": { "type": "boolean" },
        "healthcheck": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "tool_calling": { "type": "boolean" },
        "structured_output": { "type": "boolean" }
      }
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "optional_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "min_items": { "type": "integer", "minimum": 0 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["dataset_loop", "single_request", "paired_request_loop"] },
          "iterations_per_item": { "type": "integer", "minimum": 1 },
          "record_metrics": { "type": "boolean" },
          "order": { "type": "string", "enum": ["sequential", "random"] },
          "cooldown_ms": { "type": "integer", "minimum": 0 },
          "pre_iteration_delay_ms": { "type": "integer", "minimum": 0 },
          "intra_pair_delay_ms": { "type": "integer", "minimum": 0 },
          "pair": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "enum": ["baseline", "comparison", "control", "variant", "technical"] },
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reuse": { "type": "string", "enum": ["default"] }
                  }
                }
              }
            }
          },
          "derived_metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "left", "right"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "enum": ["difference"] },
                "left": { "type": "string", "minLength": 1 },
                "right": { "type": "string", "minLength": 1 },
                "unit": { "type": "string" }
              }
            }
          },
          "observability": { "type": "object", "additionalProperties": true },
          "stop_on_error": { "type": "boolean" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "elapsed_ms",
              "first_token_ms",
              "tokens_per_second",
              "decode_tokens_per_second",
              "prefill_tokens_per_second",
              "output_input_token_ratio",
              "tool_call_count",
              "tool_selected_correctly",
              "tool_arguments_valid",
              "missing_tool_call",
              "hallucinated_tool_call",
              "json_valid",
              "schema_valid",
              "regex_match",
              "exact_match",
              "contains_required_terms"
            ]
          },
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
            "description": "Stage-derived metric id declared by derived_metrics, or a pair metric path such as pair.baseline.elapsed_ms."
          }
        ]
      },
      "uniqueItems": true
    },
    "aggregations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["mean", "median", "min", "max", "sum", "count", "p50", "p90", "p95", "p99", "stddev", "variance"] },
      "uniqueItems": true
    },
    "metadata": { "type": "object", "additionalProperties": true },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}
