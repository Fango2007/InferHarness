{
  "kind": "test_template",
  "schema_version": "benchmark_test_template_v1",
  "template_id": "verbosity_ratio_v1",
  "template_version": "1.0.0",
  "name": "Verbosity Ratio",
  "description": "Measures output-to-input token ratio.",
  "operation": "chat_completion",
  "required_capabilities": {
    "chat_completion": true,
    "streaming": false,
    "tool_calling": false,
    "structured_output": false
  },
  "input_contract": {
    "required_fields": ["prompt"],
    "optional_fields": ["system_prompt", "expected_format", "tags", "metadata"],
    "min_items": 1
  },
  "stages": [
    {
      "id": "measure",
      "type": "dataset_loop",
      "iterations_per_item": 5,
      "record_metrics": true,
      "order": "sequential",
      "cooldown_ms": 100,
      "stop_on_error": false
    }
  ],
  "metrics": ["input_tokens", "output_tokens", "elapsed_ms", "tokens_per_second", "output_input_token_ratio"],
  "aggregations": ["mean", "median", "p95", "max"],
  "metadata": {}
}
